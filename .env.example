# Website administrator access (use a unique random value of 24+ characters)
ADMIN_WEB_KEY=

# Persistent SQLite file; set this to a mounted Railway volume in production
DATABASE_PATH=/data/shop_database.db

# FamGateway payment integration
FAMGATEWAY_API_KEY=
FAMGATEWAY_BASE_URL=https://famgateway.in

# Reseller digital-key delivery API
XYZ_API_KEY=
XYZ_MASTER_KEY=
XYZ_API_URL=https://bantibhaiya.to/api/reseller_v1.php

# Railway supplies PORT automatically; local default is 8080
PORT=8080
