# Admin is created on first boot if the admin table is empty. Use protected Railway variables.
# Put the exact admin email/password you want in Railway, not in this file or GitHub.
ADMIN_EMAIL=hexchaetsofc@gamil.com
ADMIN_PASSWORD=HexMods80887879
# Optional transition-only shared key; prefer the email/password account above.
ADMIN_WEB_KEY=replace-with-a-random-secret-at-least-24-characters

# FamGateway: keep any existing Railway values for these keys.
FAMGATEWAY_API_KEY=
FAM_API_KEY=
FAMPAY_API_KEY=
FAMGATEWAY_BASE_URL=https://famgateway.in

# Reseller API: keep any existing Railway values for these keys.
XYZ_API_KEY=
XYZ_MASTER_KEY=
