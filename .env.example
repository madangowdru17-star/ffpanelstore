# Admin bootstrap: use protected Railway variables, never credentials in this example file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Optional transition-only shared key; prefer the email/password account above.
ADMIN_WEB_KEY=replace-with-a-random-secret-at-least-24-characters

# FamGateway: keep any existing Railway values for these keys.
FAMGATEWAY_API_KEY=
FAM_API_KEY=
FAMPAY_API_KEY=
FAMGATEWAY_BASE_URL=https://famgateway.in

# Reseller API: keep any existing Railway values for these keys.
XYZ_API_KEY=
XYZ_MASTER_KEY=
XYZ_API_URL=https://bantibhaiya.to/api/reseller_v1.php

# Do not change this on a live deployment: preserve the existing database path.
DATABASE_PATH=/data/shop_database.db

# Google Sign-In (set real values as protected Railway variables, never commit them).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ffpanelstore.up.railway.app/auth/google/callback

# Railway injects PORT; this is the local default.
PORT=8080
